async fn all<T>(promises: [Promise<T>]) -> [T] {
    return for promise in promises { await promise };
};

async fn race<T>(promises: [Promise<T>]) -> T {
    return nativeAsync::race(promises: promises);
};

async fn timeout<T>(promise: Promise<T>, millis: int) -> T {
    return nativeAsync::timeout(promise: promise, millis: millis);
};

async fn resolve<T>(value: T) -> T {
    return value;
};

async fn delay(millis: int) -> void {
    nativeTime::sleepMillis(millis: millis);
    return;
};
