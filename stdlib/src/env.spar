function get(name: str) -> str {
    return nativeEnv::get(name: name);
};

function getOr(name: str, fallback: str) -> str {
    if nativeEnv::has(name: name) {
        return nativeEnv::get(name: name);
    }
    return fallback;
};

function has(name: str) -> bool {
    return nativeEnv::has(name: name);
};

function set(name: str, value: str) -> void {
    nativeEnv::set(name: name, value: value);
    return;
};

function unset(name: str) -> void {
    nativeEnv::unset(name: name);
    return;
};

function keys() -> [str] {
    return nativeEnv::keys();
};
