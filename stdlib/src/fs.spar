export struct FileMetadata {
    size: int;
    isFile: bool;
    isDir: bool;
    modifiedMillis: int;
};

fn readText(path: str) -> str {
    return nativeFs::readText(path: path);
};

fn writeText(path: str, content: str) -> void {
    nativeFs::writeText(path: path, content: content);
    return;
};

fn appendText(path: str, content: str) -> void {
    nativeFs::appendText(path: path, content: content);
    return;
};

fn readBytes(path: str) -> Bytes {
    return nativeFs::readBytes(path: path);
};

fn writeBytes(path: str, content: Bytes) -> void {
    nativeFs::writeBytes(path: path, content: content);
    return;
};

fn exists(path: str) -> bool {
    return nativeFs::exists(path: path);
};

fn isFile(path: str) -> bool {
    return nativeFs::isFile(path: path);
};

fn isDir(path: str) -> bool {
    return nativeFs::isDir(path: path);
};

fn metadata(path: str) -> FileMetadata {
    return nativeFs::metadata(path: path);
};

fn createDir(path: str, recursive: bool) -> void {
    nativeFs::createDir(path: path, recursive: recursive);
    return;
};

fn removeFile(path: str) -> void {
    nativeFs::removeFile(path: path);
    return;
};

fn removeDir(path: str, recursive: bool) -> void {
    nativeFs::removeDir(path: path, recursive: recursive);
    return;
};

fn copy(from: str, to: str) -> int {
    return nativeFs::copy(from: from, to: to);
};

fn move(from: str, to: str) -> void {
    nativeFs::move(from: from, to: to);
    return;
};
