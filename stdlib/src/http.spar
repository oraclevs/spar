export type [HttpResponse] {
    status: int;
    body: str;
};

async function request(method: str, url: str, body: str = "") -> HttpResponse {
    return nativeHttp::request(method: method, url: url, body: body);
};

async function get(url: str) -> HttpResponse {
    return nativeHttp::request(method: "GET", url: url, body: "");
};

async function delete(url: str) -> HttpResponse {
    return nativeHttp::request(method: "DELETE", url: url, body: "");
};

async function post(url: str, body: str) -> HttpResponse {
    return nativeHttp::request(method: "POST", url: url, body: body);
};

async function put(url: str, body: str) -> HttpResponse {
    return nativeHttp::request(method: "PUT", url: url, body: body);
};

async function patch(url: str, body: str) -> HttpResponse {
    return nativeHttp::request(method: "PATCH", url: url, body: body);
};
