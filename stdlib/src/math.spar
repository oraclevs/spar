fn absInt(value: int) -> int {
    return nativeMath::absInt(value: value);
};

fn abs(value: float) -> float {
    return nativeMath::abs(value: value);
};

fn minInt(left: int, right: int) -> int {
    return nativeMath::minInt(left: left, right: right);
};

fn maxInt(left: int, right: int) -> int {
    return nativeMath::maxInt(left: left, right: right);
};

fn min(left: float, right: float) -> float {
    return nativeMath::min(left: left, right: right);
};

fn max(left: float, right: float) -> float {
    return nativeMath::max(left: left, right: right);
};

fn round(value: float) -> float {
    return nativeMath::round(value: value);
};

fn floor(value: float) -> float {
    return nativeMath::floor(value: value);
};

fn ceil(value: float) -> float {
    return nativeMath::ceil(value: value);
};

fn pow(left: float, right: float) -> float {
    return nativeMath::pow(left: left, right: right);
};

fn sqrt(value: float) -> float {
    return nativeMath::sqrt(value: value);
};
