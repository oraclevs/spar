fn isStdinTty() -> bool {
    return nativeTerminal::isStdinTty();
};

fn supportsColor() -> bool {
    return nativeTerminal::supportsColor();
};

fn isStdoutTty() -> bool {
    return nativeTerminal::isStdoutTty();
};

fn isStderrTty() -> bool {
    return nativeTerminal::isStderrTty();
};

fn width() -> int {
    return nativeTerminal::width();
};

fn height() -> int {
    return nativeTerminal::height();
};

fn bold(text: str) -> str {
    return nativeTerminal::style(code: 1, text: text);
};

fn red(text: str) -> str {
    return nativeTerminal::style(code: 31, text: text);
};

fn green(text: str) -> str {
    return nativeTerminal::style(code: 32, text: text);
};

fn yellow(text: str) -> str {
    return nativeTerminal::style(code: 33, text: text);
};

fn blue(text: str) -> str {
    return nativeTerminal::style(code: 34, text: text);
};

fn clearScreen() -> str {
    return nativeTerminal::clearScreen();
};

fn moveCursor(row: int, column: int) -> str {
    return nativeTerminal::moveCursor(row: row, column: column);
};

fn dim(text: str) -> str {
    return nativeTerminal::style(code: 2, text: text);
};

fn underline(text: str) -> str {
    return nativeTerminal::style(code: 4, text: text);
};

fn cyan(text: str) -> str {
    return nativeTerminal::style(code: 36, text: text);
};

fn magenta(text: str) -> str {
    return nativeTerminal::style(code: 35, text: text);
};

fn reset() -> str {
    return nativeTerminal::reset();
};

fn clearLine() -> str {
    return nativeTerminal::clearLine();
};

fn hideCursor() -> str {
    return nativeTerminal::hideCursor();
};

fn showCursor() -> str {
    return nativeTerminal::showCursor();
};

fn saveCursor() -> str {
    return nativeTerminal::saveCursor();
};

fn restoreCursor() -> str {
    return nativeTerminal::restoreCursor();
};

fn enterAlternateScreen() -> str {
    return nativeTerminal::enterAlternateScreen();
};

fn leaveAlternateScreen() -> str {
    return nativeTerminal::leaveAlternateScreen();
};

fn prompt(message: str) -> Option<str> {
    return nativeProcess::readLine(prompt: message);
};

fn clearToEnd() -> str {
    return nativeTerminal::clearToEnd();
};

fn clearToLineEnd() -> str {
    return nativeTerminal::clearToLineEnd();
};

fn bell() -> str {
    return nativeTerminal::bell();
};

fn moveUp(count: int) -> str {
    return nativeTerminal::moveUp(count: count);
};

fn moveDown(count: int) -> str {
    return nativeTerminal::moveDown(count: count);
};

fn moveRight(count: int) -> str {
    return nativeTerminal::moveRight(count: count);
};

fn moveLeft(count: int) -> str {
    return nativeTerminal::moveLeft(count: count);
};

fn redIfColor(text: str) -> str {
    if supportsColor() { return red(text: text); }
    return text;
};

fn boldIfColor(text: str) -> str {
    if supportsColor() { return bold(text: text); }
    return text;
};
