fn trim(value: str) -> str {
    return nativeText::trim(value: value);
};

fn lower(value: str) -> str {
    return nativeText::lower(value: value);
};

fn upper(value: str) -> str {
    return nativeText::upper(value: value);
};

fn contains(value: str, needle: str) -> bool {
    return nativeText::contains(value: value, needle: needle);
};

fn startsWith(value: str, needle: str) -> bool {
    return nativeText::startsWith(value: value, needle: needle);
};

fn endsWith(value: str, needle: str) -> bool {
    return nativeText::endsWith(value: value, needle: needle);
};

// Parses a human-readable byte size ("10GB", "1.5 GiB", "512K", a bare
// number of bytes) into an int, for comparing against a table's numeric
// `size` column: `f.size > parseSize(value: "10GB")`.
fn parseSize(value: str) -> int {
    return nativeText::parseSize(value: value);
};

fn replace(value: str, from: str, to: str) -> str {
    return nativeText::replace(value: value, from: from, to: to);
};

fn split(value: str, separator: str) -> [str] {
    return nativeText::split(value: value, separator: separator);
};

fn join(values: [str], separator: str) -> str {
    return nativeText::join(values: values, separator: separator);
};
