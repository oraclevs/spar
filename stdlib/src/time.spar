fn nowMillis() -> int {
    return nativeTime::nowMillis();
};

fn sleepMillis(millis: int) -> void {
    nativeTime::sleepMillis(millis: millis);
    return;
};

fn seconds(value: int) -> int {
    return value * 1000;
};

fn minutes(value: int) -> int {
    return value * 60000;
};

fn elapsedMillis(startMillis: int) -> int {
    return nativeTime::nowMillis() - startMillis;
};

fn formatIso8601(millis: int) -> str {
    return nativeTime::formatIso8601(millis: millis);
};

fn parseIso8601(value: str) -> int {
    return nativeTime::parseIso8601(value: value);
};

