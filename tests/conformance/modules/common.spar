function borderRadiusCircular(all: int) -> List<int> {
    return [all, all, all, all];
};

function paddingAll(all: int) -> List<int> {
    return [all, all, all, all];
};

function colorWithAlpha(color: str, alpha: float) -> str {
    return color;
};

export struct Colors {
    red: str = "red";
};
