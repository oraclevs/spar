struct Pair<T, V> { left: T; right: V; };
struct Container<T> { values: List<T>; };
fn main() -> int {
    var example: Pair<str, int> = Pair<str, int>(left: "hello", right: 42);
    var names: Container<str> = Container<str>(values: ["a", "b"]);
    if example.left == "hello" { return example.right; }
    return 1;
};
