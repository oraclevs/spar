import pkg { writeText, readText, removeFile } from "std/fs";
import pkg { join } from "std/path";

fn main() -> int {
    var file: str = join(left: ".", right: "spar-stdlib-smoke.txt");
    writeText(path: file, content: "Hello from Spar");
    var contents: str = readText(path: file);
    println(value: contents);
    removeFile(path: file);

    if contents == "Hello from Spar" {
        return 0;
    }
    return 1;
};
